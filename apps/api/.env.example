# Copy to apps/api/.env and fill in. Never commit .env.
# These are SERVER-SIDE values. None of them belong in the mobile app.

NODE_ENV=development

# 0.0.0.0 lets your iPhone reach the API over Wi-Fi during development.
HOST=0.0.0.0
PORT=3000

# Supabase project URL (Dashboard -> Project Settings -> Data API / API).
# Used to verify user JWTs against the project's public signing keys (JWKS).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Postgres connection string. Use the *Session pooler* string from
# Dashboard -> Connect (works over IPv4). It contains your DB password: secret.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# "require" for Supabase. Use "disable" only for a local Postgres without TLS.
DATABASE_SSL=require

# Max connections this API process opens.
DATABASE_POOL_MAX=10

# Expected "aud" claim in Supabase access tokens.
JWT_AUDIENCE=authenticated
