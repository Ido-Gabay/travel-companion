# Copy to apps/api/.env and fill in. Never commit .env.
# These are SERVER-SIDE values. None of them belong in the mobile app.

NODE_ENV=development

# 0.0.0.0 lets your iPhone reach the API over Wi-Fi during development.
HOST=0.0.0.0
PORT=3000

# Supabase project URL (Dashboard -> Project Settings -> Data API / API).
# Used to verify user JWTs against the project's public signing keys (JWKS).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Postgres connection string. Use the *Session pooler* string from
# Dashboard -> Connect (works over IPv4). It contains your DB password: secret.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# "require" for Supabase. Use "disable" only for a local Postgres without TLS.
DATABASE_SSL=require

# Max connections this API process opens.
DATABASE_POOL_MAX=10

# Expected "aud" claim in Supabase access tokens.
JWT_AUDIENCE=authenticated

# --- Optional integrations (features answer NOT_CONFIGURED without them) ---
# Google Places API (New) server key. Restrict it to "Places API (New)" only.
# Never put this key in the mobile app.
GOOGLE_PLACES_API_KEY=
# Claude API key (console.anthropic.com). Server-side only.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Cost caps (daily / monthly) that keep usage inside Google's free monthly
# allowances (docs/GOOGLE_AND_AI.md). Raising a monthly cap past the free
# allowance can cost money: get the owner's approval first.
GOOGLE_TEXT_SEARCH_DAILY_CAP=160
GOOGLE_TEXT_SEARCH_MONTHLY_CAP=4500
GOOGLE_PLACE_DETAILS_DAILY_CAP=160
GOOGLE_PLACE_DETAILS_MONTHLY_CAP=4500
GOOGLE_PLACE_PREVIEW_DAILY_CAP=30
GOOGLE_PLACE_PREVIEW_MONTHLY_CAP=900
GOOGLE_PLACE_PHOTO_DAILY_CAP=60
GOOGLE_PLACE_PHOTO_MONTHLY_CAP=900
AI_DAILY_CAP=300
AI_MONTHLY_CAP=3000
