# Copy to apps/mobile/.env (or run `pnpm setup:mobile` from the repo root).
# EVERYTHING here is compiled into the app and readable by anyone who has it.
# Only public values belong here. Never put DATABASE_URL, a secret key or the
# service-role key in this file.

# Supabase project URL.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase publishable key (Project Settings -> API Keys, starts with sb_publishable_).
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Travel Companion API. During development, your Mac's Wi-Fi IP so the iPhone can reach it,
# e.g. http://192.168.1.20:3000. In production, the deployed HTTPS URL.
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000

# Google Maps SDK for iOS key (NOT an EXPO_PUBLIC_ variable: it's only read by
# app.config.ts at build time and written into the native app). Restrict it in
# Google Cloud to iOS apps with bundle ID com.idogabay.travelcompanion and to the
# "Maps SDK for iOS" API. After changing it, rebuild with `pnpm ios`.
GOOGLE_MAPS_IOS_API_KEY=
