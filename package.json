{
  "name": "travel-companion",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "postinstall": "pnpm --filter @travel-companion/shared build",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "test": "pnpm build:shared && pnpm -r test",
    "setup:db": "node scripts/set-database-url.mjs",
    "smoke:api": "node scripts/smoke-test-api.mjs",
    "setup:mobile": "node scripts/setup-mobile-env.mjs",
    "dev:api": "pnpm build:shared && pnpm --filter @travel-companion/api dev",
    "dev:mobile": "pnpm build:shared && pnpm --filter @travel-companion/mobile start",
    "ios": "pnpm build:shared && pnpm --filter @travel-companion/mobile ios",
    "ios:device": "pnpm build:shared && pnpm --filter @travel-companion/mobile ios:device",
    "dev:shared": "pnpm --filter @travel-companion/shared dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:shared": "pnpm --filter @travel-companion/shared build"
  },
  "devDependencies": {
    "prettier": "^3.6.0"
  }
}
